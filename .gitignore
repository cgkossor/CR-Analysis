# --- Data ------------------------------------------------------------------
# Databases are ignored by DEFAULT so that real formulation data cannot be
# committed by accident. This matters more than it looks: a public repository is
# forked, cached and indexed within minutes, and deleting a file in a later
# commit does not remove it from history.
#
# The synthetic placeholder is allowed back in explicitly, by name, because it
# is labelled non-experimental and lets anyone run the pipeline.
#
# To publish a different database on purpose:  git add -f <file>
*.xlsx
*.xls
*.xlsm
*.csv
*.tsv
*.parquet
!CR_matrix_tablet_dissolution_PLACEHOLDER*.xlsx

# --- Generated artifacts ---------------------------------------------------
# All regenerated by:  python -m pipeline.run --input <database>
# Excluded because they are derived, and because on a real database they would
# publish the analysis results as surely as publishing the data would.
outputs/
docs/guidelines.md
dashboard/data.js
dist/

# --- Environment -----------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
