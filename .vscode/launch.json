{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run pipeline (pick a database)",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.run",
      "args": ["--input", "${input:databaseFile}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Run pipeline (currently open .xlsx)",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.run",
      "args": ["--input", "${file}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Run pipeline + determinism check",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.run",
      "args": ["--input", "${input:databaseFile}", "--check-determinism"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    },
    {
      "name": "Build email packages",
      "type": "debugpy",
      "request": "launch",
      "module": "pipeline.package",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "databaseFile",
      "type": "promptString",
      "description": "Path to the dissolution workbook (.xlsx)",
      "default": "CR_matrix_tablet_dissolution_PLACEHOLDER (1).xlsx"
    }
  ]
}
